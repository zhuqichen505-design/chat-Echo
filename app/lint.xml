<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        仅禁用 Compose Lint 中依赖 kotlinx-metadata 读取 @Composable 的探测器。
        根因：项目 Kotlin 2.2.21 产出 Metadata 2.2.0，而当前 AGP/Compose Lint 内嵌的
        kotlinx-metadata-jvm 最高只支持 2.0.0，探测器在 isComposable() 解析时直接抛异常
        （工具链缺陷，与业务代码无关；旧代码同样会触发）。
        其余全部 Lint 规则保持启用，未关闭 lint 整体检查。
    -->
    <issue id="UnrememberedAnimatable" severity="ignore" />
    <issue id="StateFlowValueCalledInComposition" severity="ignore" />
    <issue id="CoroutineCreationDuringComposition" severity="ignore" />
    <issue id="UnrememberedMutableState" severity="ignore" />
    <issue id="AutoboxingStateCreation" severity="ignore" />
    <issue id="MutableCollectionMutableState" severity="ignore" />
    <issue id="ComposableNaming" severity="ignore" />
    <issue id="ComposableModifierFactory" severity="ignore" />
    <issue id="ModifierParameter" severity="ignore" />
    <issue id="ModifierFactoryUnreferencedReceiver" severity="ignore" />
    <issue id="LambdaParameterInComposition" severity="ignore" />
    <issue id="ComposableAnnotation" severity="ignore" />
    <issue id="ParameterNaming" severity="ignore" />
    <issue id="RememberReturnType" severity="ignore" />
    <issue id="UnrememberedAnimatable" severity="ignore" />
    <issue id="CompositionLocalNaming" severity="ignore" />
    <issue id="MutableAndUnmutableCollections" severity="ignore" />
</lint>
