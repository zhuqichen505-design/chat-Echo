<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dynamic whitelist is enforced by HttpAccessPolicy on EVERY app-owned HTTP client.
         Android cannot read user preferences here; do not add unguarded clients. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
